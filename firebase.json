{
  "functions": {
    "source": "functions"
  },
  "hosting": [
    {
      "target": "map",
      "public": "frontend/dist",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    },
    {
      "target": "erp",
      "public": "erp/dist",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "rewrites": [
        {
          "source": "/api/generarAnalisisCrm",
          "function": {
            "functionId": "generarAnalisisCrm",
            "region": "us-central1"
          }
        },
        {
          "source": "/api/importInventoryCsv",
          "function": {
            "functionId": "importInventoryCsv",
            "region": "us-central1"
          }
        },
        {
          "source": "/api/ingestEcommerceOrder",
          "function": {
            "functionId": "ingestEcommerceOrder",
            "region": "us-central1"
          }
        },
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  }
}
