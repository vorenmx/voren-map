rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // CSV data files — readable only by @voren.com.mx Google accounts.
    // Cloud Functions access storage via the Admin SDK which bypasses these rules.
    match /csvs/{allPaths=**} {
      allow read:  if request.auth != null
        && request.auth.token.email != null
        && (
          request.auth.token.email.lower().matches('.*@voren\\.com\\.mx')
          || request.auth.token.email.lower() == 'enderson@propik.co'
        );
      allow write: if false;
    }
  }
}
